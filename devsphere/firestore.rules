rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(db)/documents/users/$(request.auth.uid))
        && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Profiles: users read/create their own (role must be 'user'); only admins change roles.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'user';
      allow update: if signedIn() && ((request.auth.uid == uid && request.resource.data.role == resource.data.role) || isAdmin());
      allow delete: if isAdmin();
    }

    // Private user content: owner or admin.
    match /{col}/{id} {
      allow read, delete: if col in ['projects', 'tasks', 'notes', 'resources']
        && signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if col in ['projects', 'tasks', 'notes', 'resources']
        && signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if col in ['projects', 'tasks', 'notes', 'resources']
        && signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin())
        && request.resource.data.ownerId == resource.data.ownerId;
    }

    match /logs/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
    }
    match /notifications/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
